# HAProxy Analytics — local configuration template.
#
# Copy this file to .env and edit values for your host. .env is ignored by
# git. Never commit real credentials, private hostnames or private addresses.
#
# The application has no login. Keep APP_BIND on 127.0.0.1 and put HAProxy in
# front for TLS and authentication. See docs/haproxy.md and docs/security.md.

# ---------------------------------------------------------------------------
# Image and web listener
# ---------------------------------------------------------------------------
IMAGE_TAG=latest
APP_BIND=127.0.0.1
# Host port published by Compose. The app always listens on 8080 inside.
APP_PORT=8009
TZ=UTC

# ---------------------------------------------------------------------------
# Log source: mounted file
# ---------------------------------------------------------------------------
# Host directory containing the HAProxy log file. The file is mounted read-only.
HAPROXY_LOG_DIR=./logs
# Host directory for optional persistent syslog history (mounted read-write).
DATA_DIR=./data
# Path inside the container. Set to an empty value only when using syslog only.
HAPROXY_LOG_FILE=/logs/haproxy.log
MAX_LOG_BYTES=33554432
REFRESH_SECONDS=60
MAX_VISITOR_ROWS=5000
# Newest individual HTTP requests retained for the Requests view/API.
MAX_REQUEST_ROWS=2000
# Mask non-global client IPs (private, loopback, documentation).
MASK_INTERNAL_IPS=true
# Additional networks to mask even if public, comma-separated CIDRs.
# Example: MASK_NETWORKS=192.0.0.0/8,172.0.0.0/8
MASK_NETWORKS=
# Use one full mask instead of prefix masks: x.x.x.x / x:x:x:x:x:x:x:x.
MASK_FULL=false

# ---------------------------------------------------------------------------
# GeoLite2 databases (read-only)
# ---------------------------------------------------------------------------
# Host directory containing GeoLite2-City.mmdb and GeoLite2-ASN.mmdb.
GEOIP_DIR=./geoip
GEOIP_CITY_DB=/geoip/GeoLite2-City.mmdb
GEOIP_ASN_DB=/geoip/GeoLite2-ASN.mmdb

# Optional one-shot GeoIP updater profile:
#   docker compose --profile geoip run --rm geoip-update
# It does not schedule itself. See docs/geoip.md for cron and systemd timer
# examples. The app itself never needs these credentials.
GEOIP_ACCOUNT_ID=YOUR_MAXMIND_ACCOUNT_ID
GEOIP_LICENSE_KEY=YOUR_MAXMIND_LICENSE_KEY
GEOIP_EDITION_IDS=GeoLite2-City GeoLite2-ASN

# ---------------------------------------------------------------------------
# Optional syslog receiver
# ---------------------------------------------------------------------------
# Leave SYSLOG_LISTEN empty to disable the receiver. To enable it, use the
# container-side bind 0.0.0.0:5514. The Compose file already publishes the
# receiver ports on 127.0.0.1; set SYSLOG_BIND to a reachable host interface
# only when a remote sender must connect. Keep the allowlist narrow.
# Never put the host IP or the HAProxy IP in SYSLOG_LISTEN.
SYSLOG_LISTEN=
SYSLOG_PROTOCOLS=udp
SYSLOG_ALLOWED_NETWORKS=127.0.0.0/8,::1/128
# In-memory ring only; nothing is written to disk. When full, the oldest
# lines are dropped. 200k lines can use significant RAM.
SYSLOG_BUFFER_LINES=200000
SYSLOG_MAX_MESSAGE_BYTES=65536

# Optional persistent syslog history. Set to /data/syslog.log to survive
# restarts and reboots. The data directory must be writable by UID/GID 10001.
# Empty disables persistence and keeps the receiver memory-only.
SYSLOG_STORE_FILE=
SYSLOG_STORE_MAX_BYTES=536870912
SYSLOG_STORE_BACKUPS=1

# Host interface and port used by the optional Compose port mappings.
SYSLOG_BIND=127.0.0.1
SYSLOG_PORT=5514

# Optional TCP TLS termination for the syslog receiver. Enable tcp in
# SYSLOG_PROTOCOLS, mount ./certs, and use container paths here.
# SYSLOG_TLS_CERT=/certs/server.crt
# SYSLOG_TLS_KEY=/certs/server.key
# SYSLOG_TLS_CA=/certs/ca.crt
# SYSLOG_TLS_REQUIRE_CLIENT_CERT=false
SYSLOG_CERT_DIR=./certs

# ---------------------------------------------------------------------------
# Trusted reverse proxies for /api/whoami
# ---------------------------------------------------------------------------
# Comma-separated IPs or CIDRs. Only the immediate peer must match. Never put
# an arbitrary network here: X-Forwarded-For is untrusted otherwise.
TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# Optional GoAccess report
# ---------------------------------------------------------------------------
# The image contains GoAccess. The built-in HTTP view works without it.
GOACCESS_ENABLED=false
GOACCESS_BINARY=goaccess
GOACCESS_CONFIG=/app/config/goaccess-haproxy.conf
# Optional comma-separated frontend allowlist for GoAccess input.
# Empty includes every HTTP frontend. Example: GOACCESS_FRONTENDS=ft_web
GOACCESS_FRONTENDS=
GOACCESS_TIMEOUT=60
GOACCESS_MAX_LINES=100000
GOACCESS_MAX_HTML_BYTES=5000000

# Container log level: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Demo mode (no log file required)
# ---------------------------------------------------------------------------
DEMO_MODE=false
